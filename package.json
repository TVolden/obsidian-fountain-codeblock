{
	"name": "obsidian-fountain-codeblock",
	"version": "1.0.0",
	"description": "Obsidian plugin that renders Fountain screenplay markup in fountain code blocks.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [
		"obsidian",
		"fountain",
		"screenplay"
	],
	"author": "Thomas Volden",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"dependencies": {
		"fountain-js": "^1.2.4"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/TVolden/obsidian-fountain-codeblock.git"
	},
	"homepage": "https://github.com/TVolden/obsidian-fountain-codeblock#readme",
	"bugs": {
		"url": "https://github.com/TVolden/obsidian-fountain-codeblock/issues"
	}
}
